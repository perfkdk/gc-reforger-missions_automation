$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 1523.177 68.4 6938.293
  m_sTitle "I. Situation"
  m_sTextData "RU forces have launched a surprise offensive, catching NATO forces off guard."\
  ""\
  "Deployed as part of NATO's Enhanced Forward Presence, your platoon - has been tasked with assiting in an attack by an infantry platoon to the east."\
  ""\
  "They are stepping off after this briefing."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 1
 }
 {
  coords 1522.922 68.724 6932.446
  m_sTitle "II. Friendly Forces"
  m_sTextData "x1 LAR platoon, x4 LAV-25s:"\
  "	Organic to the platoon is a drone hunter/killer team, MAAWs team, "\
  "	Jav gunner, Marksman, and an MMG team."\
  ""\
  ""\
  "To the East: The rifle platoon has x3 rifle squads, x1 MMG team, x1 HQ team"\
  ""\
  "Equipped with M27, M4A1, MAWs and wearing MARPAT."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 2
 }
 {
  coords 1516.688 68.146 6931.829
  m_sTitle "III. Enemy Forces"
  m_sTextData "Company strength RU located near Pihlajamaa. "\
  ""\
  "The enemy have Tigrs, BMP2s, and T90s. We know they are watching the routes into the hamlet. Expect contact prior to entering the town."\
  ""\
  "There are EN adjacent units nearby so expect counter attacks."\
  ""\
  "Wearing a mixture of camouflage patterns, equipped with Russian weaponry such as AK-74s, PKMs and SVDs."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 3
 }
 {
  coords 1517.18 68.285 6925.979
  m_sTitle "IV. Mission"
  m_sTextData "We are the supporting effort to the rifle platoon, we are to clear a route to the OBJ and destroy EN forces around with the LAVs. "\
  ""\
  "We are the heavy hitters, HQ expects us to deal with any EN armor."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 4
 }
}