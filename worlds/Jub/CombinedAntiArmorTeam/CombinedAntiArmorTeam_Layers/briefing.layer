$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 Overview {
  coords 3291.947 47.151 2221.159
  m_sTitle "Overview"
  m_sTextData "A USMC Rifle platoon(-), CAAT Section and ACE conduct a hasty defense in support of a UK recon platoon to the North-West."\
  ""\
  "<h2>Notes</h2>"\
  "• Rifle platoon CO is in overall command. RTO required for CAS."\
  "• I recommend slotting the TOWs>MK19s>AH1>M2HB> Rifles in that order. Asset heavy mission!"\
  ""
  m_bEmptyFactionVisibility 1
 }
 MissionNotes {
  coords 3291.92 46.64 2209.38
  m_sTitle "Mission Notes"
  m_sTextData "Mission by jubxxxjub"\
  ""\
  "AO limit in effect, AH-1 has an exception"\
  ""\
  "JIP TP"\
  ""\
  "End conditions:"\
  ""\
  "30 Minutes pass: Victory"\
  ""\
  "80% US player causalties: Defeat"\
  "100% UK AI causalties: New conditions start."\
  "Upon UK loss, you are to extract 80% of players back to the T intersection you started at. The zone radius is 25m."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 10
 }
 "I.Situation" {
  coords 3277.077 50.22 2207.697
  m_sTitle "I. Situation"
  m_sTextData "The year is 2009, the country of Takistan has been invaided by coalition forces."\
  ""\
  "You are apart of a combined US, UK taskforce."\
  ""\
  "To the NW along the ASR, a UK recon patrol has made contact with locals informing of a Takistani army armored column approaching them.  The main effort of the UK TF is locked in heavy fighting to the West and is unable to send reinforcements. We have broken off our BLTs route North to support them."\
  ""\
  ""
  m_bShowForAnyFaction 1
 }
 "II.FriendlyForces" {
  coords 3270.781 52.021 2208.541
  m_sTitle "II. Friendly Forces"
  m_sTextData "1x USMC Rifle Squad(+) with a truck"\
  "1x USMC CAAT with x2 MK19 M1151s, x2 M2HB M1151s, and x2 TOW carriers"\
  ""\
  "Note: The CAAT is divided into two squads, each with one of the aforementioned humvees. TL is the Vic CO, the rifleman are drivers and gunners respectively."\
  "*****TOW GUNNERS***** LOWER YOUR PANELS, LEST YE WISH TO PERISH"\
  ""\
  "x1 UK motorized Recon Platoon(AI) with landrovers"\
  ""\
  "The ACE assets are located at a FARP to the South and are TYPE 2 to the PL RTO."\
  "ACE has x1 AH-1 with rockets and TOWs."
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 "III.EnemyForces" {
  coords 3267.547 51.84 2202.581
  m_sTitle "III. Enemy Forces"
  m_sTextData "Civ intel suggests a Company sized group with a Platoon of T72s and two platoons of BMP2s."\
  "x2-4 T-72s, x5-8 BMPs"\
  ""\
  "According to TKA TO-E, there will likely be SPAA in the form of ZSU23s on ural trucks."\
  ""\
  "They'll have dismounts, roughly 48-60."\
  ""\
  "Their weapons include AKs, M16s, FN-FALs, SVDs, RPKs, PKMs, RPGs."\
  ""\
  "They wear OD soviet style uniforms."
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 "IV.Mission" {
  coords 3264.814 53.251 2206.532
  m_sTitle "IV. Mission"
  m_sTextData "Support the friendly recon platoon to the NW in their defence for 30min"
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 "V.Sustainment" {
  coords 3266.036 53.313 2208.564
  m_sTitle "V. Sustainment"
  m_sTextData "None"
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 "VI.Comsig" {
  coords 3266.104 53.436 2209.668
  m_sTitle "VI. Comsig"
  m_sTextData "Gound Element stay on default FREQs"\
  "Air net: +0.1MHz"\
  ""\
  "Callsigns: "\
  "1'6 - Rifle Platoon HQ"\
  "1'1 - First Rifle Squad"\
  "3'1 - CAAT 1"\
  "3'2 - CAAT 2"\
  "AH-1 - Rocket 6'7"
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
}