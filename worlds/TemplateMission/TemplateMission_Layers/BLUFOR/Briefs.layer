$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 SIT {
  coords 3205.355 399.547 11725.5
  m_sTitle "Situation"
  m_sTextData "<h2>PRELIMS</h2>"\
  "<b>DTL:</b> 01/11/1997, 0445h, Ruha."\
  "<b>Weather:</b> Cloudy skies, visibility out to 1km+, forecast expected to change."\
  ""\
  "<h2>LORE</h2>"\
  "A description of the events that have led to the situation we find ourselves in now. This is where you can cover the wider lore and story surrounding the conflict, including the political landscape, what has happened in the past, who is involved, and why they are involved."\
  ""\
  "Build your story here. Use this section to create the immersion that draws players into the mission."
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 1
 }
 EF {
  coords 3205.355 399.547 11725.5
  m_sTitle "Enemy Forces"
  m_sTextData "<h2>COMPOSITION & DISPOSITION</h2>"\
  "Enemy forces consist of approximately a platoon-minus of FIA light infantry occupying the barnyard at Parallel. The position was previously cleared by Canadian forces before being reoccupied by the FIA during ongoing fighting in the surrounding area."\
  ""\
  "<h2>STRENGTHS & CAPABILITIES</h2>"\
  "• No armed or armoured vehicles have been spotted in the area."\
  "• The FIA have had time to reoccupy and prepare the position. Expect the barnyard to contain established defensive positions and fortifications."\
  "• Their familiarity with the location and surrounding terrain may allow them to effectively defend the position against our assault."
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 2
 }
 FF {
  coords 3205.355 399.547 11725.5
  m_sTitle "Friendly Forces"
  m_sTextData "<h2>COMPOSITION & DISPOSITION</h2>"\
  "We are <b>C Company, 3rd Battalion, Princess Patricia's Canadian Light Infantry (3 PPCLI)</b>, consisting of 28 personnel. We are currently positioned approximately 200m north of the barnyard at Parallel, preparing to conduct our assault."\
  ""\
  "<h2>STRENGTHS & CAPABILITIES</h2>"\
  "• Light infantry only. We have no vehicles or supporting troops available."\
  "• We are operating in close proximity to the objective, allowing us to move quickly and maintain pressure on the FIA position."\
  ""\
  "<h2>SERVICE & SUPPORT</h2>"\
  "• No resupply or additional equipment is available for this operation."
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 3
 }
 MIS {
  coords 3205.355 399.547 11725.5
  m_sTitle "Mission"
  m_sTextData "<h2>MISSION STATEMENT</h2>"\
  "Conduct a <b>HASTY ASSAULT</b> to <b>DISLODGE & SECURE</b> the FIA forces occupying the barnyard at Parallel."\
  ""\
  "<h2>MISSION DESCRIPTION</h2>"\
  "An FIA platoon has manoeuvred into the barnyard at Parallel and reoccupied a position previously cleared by Canadian forces. From here, they have begun harassing Canadian forces operating along our flank and disrupting ongoing operations in the area."\
  ""\
  "We are to move quickly and assault the barnyard before the FIA can further establish themselves. <b>CLEAR</b> all hostile forces from the position and <b>SECURE</b> the barnyard, restoring control of the area and allowing friendly operations to continue uninterrupted."
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 4
 }
 CS {
  coords 3205.355 399.547 11725.5
  m_sTitle "Comsig"
  m_sTextData "<h2>CALLSIGNS</h2>"\
  "• HQ - 1'6"\
  "• 1SQD - 1'1"\
  "• 2SQD - 1'2"\
  "• 3SQD - 1'3"\
  ""\
  "<h2>CHANNELS</h2>"\
  "• Platoon - 48hz"\
  ""\
  "<h2>PASSWORDS</h2>"\
  "• Challenge: Dog | Password: Water"\
  "• Running password: 67"\
  ""\
  "<h2>PYROTECHNICS</h2>"\
  "• Red flare - Begin assault"\
  "• Green flare - Withdraw"\
  "• Purple smoke - Medical attention required"
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 5
 }
}