$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 OPFRIEND {
  coords 2048.388 0.181 9344.47
  m_sTitle "Friendly forces"
  m_sTextData "<h2>COMPOSITION & DISPOSITION</h2>  "\
  "We are the South Atropian People's Army (SAPA), currently located in the centre of town at the designated marker."\
  "Our force consists of 41 personnel."\
  ""\
  "<h2>STRENGTHS & CAPABILITIES</h2>  "\
  "• 1x BRDM with assigned crew."\
  "• Freedom of movement throughout the town and underground."\
  "A tunnel system spans the length of the entire town, providing multiple concealed routes through access hatches and stairwells."\
  "These routes can be used to manoeuvre unseen, reposition forces, and conduct ambushes against British troops. Refer to maps for known tunnel access points."\
  ""\
  "<h2>SERVICE & SUPPORT</h2>  "\
  "A supply crate at the staging area contains:"\
  "• 10x demolition charges.  "\
  "• 8x clackers.  "\
  "• 25x white flares.  "\
  "• 2x periscopes.  "\
  "• 2x ladders."\
  ""\
  "Additional transport assets available:"\
  "• 1x unarmed UAZ.  "\
  "• 2x Urals."
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 3
 }
 OPEN {
  coords 2030.281 0 9369.881
  m_sTitle "Enemy forces"
  m_sTextData "<h2>COMPOSITION & DISPOSITION</h2>  "\
  "Enemy forces consist of a British Army light infantry company currently located at their FOB, GRID: 01090069."\
  ""\
  "The British force is estimated to be approximately 80 personnel and is currently preparing to conduct an assault against our position."\
  ""\
  "<h2>STRENGTHS & CAPABILITIES</h2>  "\
  "• All enemy personnel are equipped with weapon optics, providing an advantage in observation and engagement."\
  ""\
  "• Enemy forces have no heavy weapons available."\
  "• No indirect fire support is available."\
  "• No supporting friendly units are expected."\
  "• No infrared capabilities have been identified."\
  "• No enemy vehicles have been observed."
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 4
 }
 OPMIS {
  coords 2040.626 -0.001 9465.908
  m_sTitle "Mission"
  m_sTextData "<h2>MISSION STATEMENT</h2>  "\
  "Defend our position within the town, protect our supplies, and repel the expected British assault."\
  ""\
  "<h2>MISSION DESCRIPTION</h2>  "\
  "British forces are preparing to launch an assault against our position. Our strongpoint contains critical equipment and supplies required to support future SAPA operations in the area."\
  ""\
  "The loss of these supplies would severely impact our ability to continue operations and reach our assigned area of operations. The strongpoint must be defended at all costs."\
  ""\
  "Hold the town, repel the British attack, and ensure our equipment and supplies remain under SAPA control."
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 2
 }
 OPCOMSIG {
  coords 2002.489 0 9378.273
  m_sTitle "Command & signals"
  m_sTextData "<h2>CALLSIGNS</h2>"\
  "• HQ/1st SQD - Racek41"\
  "• 2nd SQD - Race42"\
  "• 3rd SQD - Racek43"\
  "• 4th SQD - Racek44"\
  "• 1st Maneuver team - Racek45"\
  "• 2nd Maneuver team - Racek46"\
  "• 3rd Maneuver team - Racek47"\
  "• Shooter team - Racek48"\
  "• BRDM Crew - Racek49"\
  ""\
  "<h2>FREQ/CHAN</h2>"\
  "• All callsigns - 48mhz"\
  ""\
  "<h2>PASSWORDS</h2>"\
  "• <b>Challenge:</b> Honda | <b>Password:</b> Dream"\
  ""\
  "<h2>PYROTECHNICS</h2>"\
  "• White smoke/flare - Maneuvers and illumination"
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 6
 }
 OPSIT {
  coords 2028.95 -0.001 9372.723
  m_sTitle "Situation"
  m_sTextData "<h2>PRELIMS</h2>"\
  "DTL: 12/07/1993, 0530hrs, Longmoor, South of England.  "\
  "Weather: Overcast with heavy rain, dense low-level fog, visibility below 1km, winds up to 6kts. No forecast of improvement."\
  ""\
  "<h2>LORE</h2>"\
  "Exercise Shadow Light is a joint UK-US training exercise conducted by Alpha Company, 2nd Battalion, The Rifles, in preparation for a possible deployment to the Republic of Atropia."\
  ""\
  "In recent months, the South Atropian People's Army (SAPA) has launched a major offensive, overrunning much of northern Atropia and forcing government forces into a fighting withdrawal. Following a disputed election, elements of the Atropian Government have regrouped in the less populated southern regions, where they continue to resist the advance."\
  ""\
  "Despite international intervention, the situation has continued to deteriorate. With the conflict escalating and SAPA forces making steady territorial gains, British and American forces have begun preparing for a potential deployment. Exercise Shadow Light has been designed to replicate the conditions expected in theatre, ensuring coalition forces are ready should they be called upon."
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 1
 }
}