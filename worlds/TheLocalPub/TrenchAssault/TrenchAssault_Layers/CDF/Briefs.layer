  m_sTitle "Comsig"
  m_sTextData "<h2>CALLSIGNS</h2>"\
  "• HQ - 430"\
  "• 1SQD - 431"\
  "• 2SQD - 432"\
  "• 3SQD - 433"\
  ""\
  "<h2>FREQ/CHAN</h2>"\
  "• All callsigns - 42hz"\
  ""\
  "<h2>PASSWORDS</h2>"\
  "All can be changed at CO's discretion."\
  "• <b>Challenge:</b> Centrum | <b>Password:</b> point"\
  "• Running password: 22"
