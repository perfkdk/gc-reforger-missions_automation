$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 A_Situation_SEP {
  coords 4205.061 433.468 6289.29
  m_sTitle "I. Situation"
  m_sTextData "DTL: 15/10/2005, 1100hr, Chernarus."\
  ""\
  "For the past week our glorious Chernarussian Movement of the Red Star has been suffering under a massive combined US and CDF offensive. Our unit has been ordered to conduct a delaying action at the dilapidated town of Hamertin which sits atop a vital road junction, this is in order to buy time for friendly forces further west to regroup and reorganize. The majority of our infantry force has been concentrated in and around the town, although a number of smaller units have been deployed forward and to the flanks."
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
 }
 B_Mission_SEP {
  coords 4208.542 433.585 6293.969
  m_sTitle "II. Mission"
  m_sTextData "Sufficiently delay or outright prevent the capture of Hamertin for at least 50 minutes."\
  ""\
  "If we are unable to hold the town then we should retreat to the west. Our most vital piece of equipment is our BMP-1P and its Konkurs ATGM, in the event of a retreat the survival of it and its crew should be prioritized."
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 1
 }
 C_FriendlyForce_SEP {
  coords 4243.041 437.873 6327.248
  m_sTitle "III. Friendly Forces"
  m_sTextData "Sec I. Composition & Strength"\
  "Our overall unit consists of roughly 3x platoons worth of irregular infantry, dispersed throughout the AO but primarily concentrated around Hamertin itself. The rough location of our various sub units have been marked. Our units are equipped with Soviet and Russian small arms, wear a wide variety of uniform patterns and camouflage, and have little if any PPE."\
  ""\
  "Sec II. Vehicles & Assets."\
  "Multiple PKM and NSV fighting positions around Hamertin, these are already manned and have been marked. Assuming our crew hasn't been killed or otherwise lost we are equiped 1x BMP-1P (Konkurs ATGM). We have 2x UAZ452 vans."\
  ""\
  "Sec III. Support & Resupply"\
  "No external support or resupply is available. "
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 2
 }
 D_EnemyForce_SEP {
  coords 4212.644 433.023 6316.542
  m_sTitle "IV. Enemy Forces"
  m_sTextData "Sec I. Composition & Strength"\
  "1x Stryker mechanized infantry platoon, believed to be the only hostile force in the AO. Consists of 1x platoon HQ, 2x rifle squads, and 1x weapons squad (2x CarlG, 2x M240). Currently located somewhere to the south east, preparing to assault Hamertin."\
  ""\
  "Sec II. Vehicles & Assets"\
  "3x M1126 Stryker APC with: slat armor, CROWS M2HB1"\
  "1x M1151 uparmored Humvee with: M2HB1"\
  ""\
  "Sec III. Support & Resupply"\
  "No hostile external support or resupply is expected."\
  ""\
  "Sec IV. MLCOA"\
  "Set up a base of fire along a portion of the high ground SE of Hamertin, followed by a rapid assault covered by said high ground making use of the mobility and protection provided by the Stryker APCs. "
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 3
 }
 E_Comsig_SEP {
  coords 4207.666 431.968 6322.635
  m_sTitle "V. Comsig"
  m_sTextData "Sec I. Callsigns"\
  "Fire Team - 1'2"\
  "BMP-1P - 1'3"\
  ""\
  "Sec II. Radio Nets"\
  "Overall - 42Mhz"\
  "BMP Internal - 43Mhz"
  m_aVisibleForFactions {
   "GC_SEPARATIST"
  }
  m_iOrder 4
 }
}