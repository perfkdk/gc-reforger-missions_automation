$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 A_Situation_US {
  coords 4195.181 429.886 6348.679
  m_sTitle "I. Situation"
  m_sTextData "DTL: 15/10/2005, 1100hr, Chernarus."\
  ""\
  "For the past week US and Chernarussian government forces have been conducting a combined offensive against the Russian backed separatist group known as the “Chernarussian Movement of the Red Star” or ChDKZ. As part of this offensive our stryker mechanized infantry platoon has been tasked with assaulting the separatist held dilapidated town of Hamertin, which is located along an important road junction. Due to the rapid pace of the ongoing offensive only limited preliminary reconnaissance has been conducted. We have an accurate idea as to the total strength and equipment of hostile forces, but little to no knowledge of their exact location in the AO beyond the assumption that they will be concentrated in and around Hamertin itself due to its abundant cover and concealment."
  m_aVisibleForFactions {
   "US"
  }
 }
 B_Mission_US {
  coords 4196.476 429.915 6331.949
  m_sTitle "II. Mission"
  m_sTextData "We are to assault and occupy the town of Hamertin, securing it and its vital road junction for follow on forces. It is not required that we eliminate all separatist forces in the AO, but Hamertin and its immediate surroundings must be cleared. We must achieve this objective within 50 minutes in order to maintain the rapid pace of the ongoing offensive, which has so far prevented any substantial regrouping of separatist forces."\
  ""\
  "Should we succeed in occupying Hamertin on time we should then prevent as much as possible the westward retreat of local separatist forces, most importantly their BMP-1P which is a significant threat due to its Konkors ATGM. Regardless of if separatists forces successfully retreat we will still achieve victory if Hamertin has been captured on time."
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 1
 }
 C_FriendForce_US {
  coords 4196.788 429.996 6332.346
  m_sTitle "III. Friendly Forces"
  m_sTextData "Sec I. Composition & Strength"\
  "Our Stryker mechanized infantry platoon is the only friendly force in the AO. Consists of 1x platoon HQ, 2x rifle squads, and 1x weapons squad (2x CarlG, 2x M240). Currently located at a staging area SE side of the AO along an ASR."\
  ""\
  "Sec II. Vehicles & Assets"\
  "3x M1126 Stryker APC with: slat armor, CROWS M2HB1"\
  "1x M1151 uparmored Humvee with: M2HB1"\
  ""\
  "Sec III. Support & Resupply"\
  "There is no external support or resupply available."
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 2
 }
 D_EnemyForce_US {
  coords 4201.158 430.771 6328.127
  m_sTitle "IV. Enemy Forces"
  m_sTextData "Sec I. Composition & Strength"\
  "Roughly 3x platoons worth of irregular infantry, dispersed throughout the AO but expected to be primarily concentrated around Hamertin itself. Equiped with little to no PPE."\
  ""\
  "Sec II. Vehicles & Assets"\
  "Multiple PKM and NSV fighting positions, exact locations unknown. 1x BMP-1P (Konkurs ATGM). Multiple GAZ 452s for the transportation of troops and supplies."\
  ""\
  "Sec III. Support & Resupply"\
  "No hostile external support or resupply is expected."\
  ""\
  "Sec IV. MLCOA"\
  "Concentrate force around Hamertin while deploying smaller units to ambush and delay along approaches to town. Contest high ground to the south east of Hamertin with long range fire from NSV hmgs and BMP-1P (Konkurs ATGM)."\
  ""
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 3
 }
 E_Comsig_US {
  coords 4203.169 431.18 6317.407
  m_sTitle "V. Comsig"
  m_sTextData "Sec I. Callsigns"\
  "Platoon Leader - 1'6A"\
  "Platoon Seargant - 1'6B"\
  "Platoon HQ - 1'6"\
  "1st Rifle Squad - 1'1"\
  "	1st Stryker	-	1'1V"\
  "2nd Rifle Squad - 1'2"\
  "	2nd Stryker 	-	1'2V"\
  "Weapons Squad - 1'3"\
  "	3rd Stryker	-	1'3V"\
  ""\
  "Sec II. Radio Nets"\
  "Platoon Net- 42Mhz"\
  "HQ - 38.0Mhz"\
  "1'1 - 38.2Mhz"\
  "1'2 - 38.4Mhz"\
  "1'3 - 38.6Mhz"
  m_aVisibleForFactions {
   "US"
  }
  m_iOrder 4
 }
}