$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 brief {
  coords 2886.054 136.981 7225.17
  m_sTitle "Mission overview"
  m_sTextData "We are a platoon(-) of Mujahideen Army tasked with destroying the US command truck located in the north of town Khas and extract."
  m_bShowForAnyFaction 1
  {
   $grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
    EnemyForces2 {
     coords 19.015 -2.268 13.71
     m_sTitle "Enemy forces"
     m_sTextData "US platoon+ armed with 2000s gear and were given Humvees with M2HB."\
     ""\
     "Trucks location has been marked on the map(037 073)"\
     ""\
     "They have set up the Humvees on specific locations to act as a checkpoint, marked on  the map."\
     ""\
     "Should the truck be destroyed OR the US takes heavy casualties a QRF consisting of 2 LAVs will come from FOB Nauzad."
     m_bShowForAnyFaction 1
     m_iOrder 3
    }
    Situation2 {
     editor EntityEditorProps "{68E71EADCDF3603B}" {
     }
     coords 16.245 6.486 10.563
     m_sTitle "Situation"
     m_sTextData "U.S. forces maintain control of a strategically location north of Khas. Security patrols continue throughout districts, with checkpoints established along major routes."\
     ""\
     "We have being tasked with destorying the command truck to weaken their control of the area and extract. "
     m_bShowForAnyFaction 1
     m_iOrder 1
    }
    Mission_notes_READ2 {
     coords 35.26 4.218 24.273
     m_sTitle "Mission notes(READ)"
     m_sTextData "US win if they eliminate 90% of Mujahideen forces or survive for 35 min."\
     ""\
     "Mujahideens have a minor win if they destroy the van but suffer 90% casualties."\
     ""\
     "Mujahideens have a major win if they destroy the van and extract. "\
     ""\
     "JIPs should walk towards their allies."
     m_bShowForAnyFaction 1
     m_iOrder 5
    }
    FriendlyForces2 {
     coords 0.057 -0.034 -0.562
     m_sTitle "Friendly forces"
     m_sTextData "We have 2x squads of Mujahideen fighters staging in Seyyedan (029 071)."\
     ""\
     "• 3x unarmed vans at our staging area."\
     "• There is a box with 2 detonators and 4 C4 blocks."\
     ""\
     "Our three extraction points are marked on the map:"\
     "• South-West  (029 067)"\
     "• East (041 081)"\
     "• North-East (047 075)"
     m_bShowForAnyFaction 1
     m_iOrder 2
    }
    Callsigns {
     coords 144.098 -30.728 -514.471
     m_sTitle "Callsigns"
     m_sTextData "Racek-11 - Platoon HQ"\
     ""\
     "Racek-12 - 1st squad"\
     ""
     m_bShowForAnyFaction 1
     m_iOrder 4
    }
   }
  }
 }
 overview {
  coords 3703.298 137.863 7175.711
  m_sTitle "Overview"
  m_sTextData "Mujahideen Army are tasked with destroying the US command truck located in the north of town Khas."
  m_bEmptyFactionVisibility 1
 }
}
