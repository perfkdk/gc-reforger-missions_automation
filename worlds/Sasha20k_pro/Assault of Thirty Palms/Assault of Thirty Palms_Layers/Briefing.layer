 A1_SITUATION {
  coords 4199.953 170 2701.206
  m_sTitle "SITUATION"
  m_sTextData "<b>Situation</b>"\
  ""\
  "The Insurgents have just siezed Thirty Palms yesterday and have significant control over the region, we need to assasult and retake the FOB."\
  "Expect heavy insurgent resistance from every side and keep your humvees safe from their RPGs. "\
  ""\
  "Intel suggests the Enemy power of about two platoons or a bit more and another platoon in hill 048 014, oh and how can i forget there is ANOTHER Platoon in the trees at 023 045 All the way up to the Hill, so be careful out there."
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 A2_MISSION {
  coords 4193.115 172.43 2722.398
  m_sTitle "MISSION"
  m_sTextData "<b>Mission</b> "\
  "Assault and clear FOB Thirty Palms in order to retake and secure the area."
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
