  m_sTitle "NOTES"
  m_sTextData "<b>Extra Notes</b>"\
  ""\
  "Total victory: Take FOB Thirty Palms and/or make the insurgent force Combat innefective"\
  "Total Defeat: Die or spend more than 40 mins on your ass"\
  ""\
