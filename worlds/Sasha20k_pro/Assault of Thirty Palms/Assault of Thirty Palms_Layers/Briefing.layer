 A1_SITUATION {
  coords 4199.953 170 2701.206
  m_sTitle "SITUATION"
  m_sTextData "<b>Situation</b>"\
  ""\
  "The Insurgents have just siezed Thirty Palms yesterday and have significant control over the region, we need to assasult it and take it back in 40 mins"\
  ""\
  "Expect heavy insurgent resistance from every side and keep your humvees safe from their RPGs. "\
  ""\
  "Intel suggests the power of about two platoons or a bit more, so be careful out there."
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
